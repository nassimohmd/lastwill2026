    },
    {
      "id": "residuary.primary.shares",
      "section": "residuary",
      "type": "shares",
      "text": {
        "en": "How should it be divided?",
        "ml": "ഇത് എങ്ങനെ വീതിക്കണം?"
      },
      "next": "residuary.contingent",
      "peopleSource": "residuary.primary.people"
    },
    {
      "id": "residuary.primary.charity",
      "section": "residuary",
      "type": "text",
      "text": {
        "en": "Which charity?",
        "ml": "ഏത് സ്ഥാപനം?"
      },
      "help": {
        "en": "Name and place — identify it precisely.",
        "ml": "പേരും സ്ഥലവും — കൃത്യമായി തിരിച്ചറിയുക."
      },
      "next": "residuary.contingent"
    },
    {
      "id": "residuary.contingent",
      "section": "residuary",
      "type": "single",
      "text": {
        "en": "If none of them survive you, everything else goes to:",
        "ml": "ഇവരാരും നിലനിൽക്കുന്നില്ലെങ്കിൽ, ബാക്കിയുള്ളതെല്ലാം ആർക്ക് പോകണം:"
      },
      "options": [
        {
