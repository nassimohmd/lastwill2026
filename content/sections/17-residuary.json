        },
        {
          "id": "alt_charity",
          "label": {
            "en": "An alternate charity",
            "ml": "മറ്റൊരു ജീവകാരുണ്യ സ്ഥാപനത്തിന്"
          },
          "next": "residuary.contingent.charity"
        },
        {
          "id": "legal_heirs",
          "label": {
            "en": "My legal heirs, as the law provides",
            "ml": "നിയമപ്രകാരമുള്ള എന്റെ അവകാശികൾക്ക്"
          }
        }
      ],
