{
  "id": "bank",
  "title": {
    "en": "Bank accounts & money",
    "ml": "ബാങ്ക് അക്കൗണ്ടുകളും പണവും"
  },
  "chapter": "money",
  "questions": [
    {
      "id": "bank.gate",
      "section": "bank",
      "type": "single",
      "text": {
        "en": "Do you have bank accounts?",
        "ml": "നിങ്ങൾക്ക് ബാങ്ക് അക്കൗണ്ടുകൾ ഉണ്ടോ?"
      },
      "gate": true,
      "options": [
        {
          "id": "yes",
          "label": {
            "en": "Yes",
            "ml": "അതെ"
          },
          "next": "bank.mode"
        },
        {
          "id": "no",
          "label": {
            "en": "No",
            "ml": "ഇല്ല"
          }
        }
      ],
      "next": "invest.gate"
    },
    {
      "id": "bank.mode",
      "section": "bank",
      "type": "single",
      "text": {
        "en": "How do you want to deal with them?",
        "ml": "അവ എങ്ങനെ കൈകാര്യം ചെയ്യണം?"
      },
      "options": [
        {
          "id": "all",
          "label": {
            "en": "All accounts together, to the same people",
            "ml": "എല്ലാ അക്കൗണ്ടുകളും ഒരുമിച്ച്, ഒരേ ആളുകൾക്ക്"
          },
          "next": "bank.all.mode"
        },
        {
          "id": "per_account",
          "label": {
            "en": "Account by account",
            "ml": "ഓരോ അക്കൗണ്ടും വെവ്വേറെ"
          },
          "next": "bank.account.bank_name"
        }
      ],
      "next": "bank.locker.gate"
    },
    {
      "id": "bank.all.mode",
      "section": "bank",
      "type": "single",
      "text": {
        "en": "Who should receive the money in all your bank accounts?",
        "ml": "നിങ്ങളുടെ എല്ലാ ബാങ്ക് അക്കൗണ്ടിലെയും പണം ആർക്ക് ലഭിക്കണം?"
