{
  "id": "invest",
  "title": {
    "en": "Investments",
    "ml": "നിക്ഷേപങ്ങൾ"
  },
  "chapter": "money",
  "questions": [
    {
      "id": "invest.gate",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "Do you have investments — shares, mutual funds, FDs, retirement funds, insurance, bonds, chit funds, or crypto?",
        "ml": "നിങ്ങൾക്ക് നിക്ഷേപങ്ങൾ ഉണ്ടോ — ഓഹരികൾ, മ്യൂച്വൽ ഫണ്ടുകൾ, സ്ഥിര നിക്ഷേപങ്ങൾ, റിട്ടയർമെന്റ് ഫണ്ടുകൾ, ഇൻഷുറൻസ്, ബോണ്ടുകൾ, ചിട്ടികൾ, ക്രിപ്റ്റോ എന്നിവ?"
      },
      "gate": true,
      "options": [
        {
          "id": "yes",
          "label": {
            "en": "Yes",
            "ml": "അതെ"
          },
          "next": "invest.item.type"
        },
        {
          "id": "no",
          "label": {
            "en": "No",
            "ml": "ഇല്ല"
          }
        }
      ],
      "next": "receivables.gate"
    },
    {
      "id": "invest.item.type",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "Which kind?",
        "ml": "ഏത് തരം?"
      },
      "options": [
        {
          "id": "shares",
          "label": {
            "en": "Shares / demat account",
            "ml": "ഓഹരികൾ / ഡീമാറ്റ് അക്കൗണ്ട്"
          }
        },
        {
          "id": "mutual_funds",
          "label": {
            "en": "Mutual funds",
            "ml": "മ്യൂച്വൽ ഫണ്ടുകൾ"
          }
        },
        {
          "id": "fd",
          "label": {
            "en": "Fixed / recurring deposit",
            "ml": "സ്ഥിര / ആവർത്തന നിക്ഷേപം"
          }
        },
        {
          "id": "retirement",
          "label": {
            "en": "PPF / EPF / NPS",
            "ml": "PPF / EPF / NPS"
          }
        },
        {
          "id": "insurance",
          "label": {
            "en": "Life insurance policy",
            "ml": "ജീവിത ഇൻഷുറൻസ് പോളിസി"
          }
        },
        {
          "id": "bonds",
          "label": {
            "en": "Bonds / gold bonds",
            "ml": "ബോണ്ടുകൾ / സ്വർണ്ണ ബോണ്ടുകൾ"
          }
        },
        {
          "id": "chit",
          "label": {
            "en": "Chit fund",
            "ml": "ചിട്ടി"
          }
        },
        {
          "id": "crypto",
          "label": {
            "en": "Crypto / digital asset",
            "ml": "ക്രിപ്റ്റോ / ഡിജിറ്റൽ ആസ്തി"
          }
        }
      ],
      "next": "invest.item.desc"
    },
    {
      "id": "invest.item.desc",
      "section": "invest",
      "type": "text",
      "text": {
        "en": "Describe it",
        "ml": "വിവരണം നൽകുക"
      },
      "help": {
        "en": "E.g. the company, folio number, bank, or policy name.",
        "ml": "ഉദാ: കമ്പനി, ഫോളിയോ നമ്പർ, ബാങ്ക്, അല്ലെങ്കിൽ പോളിസി പേര്."
      },
      "next": "invest.item.beneficiary.mode"
    },
    {
      "id": "invest.item.beneficiary.mode",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "Who should receive this?",
        "ml": "ഇത് ആർക്ക് ലഭിക്കണം?"
      },
      "options": [
        {
          "id": "one",
          "label": {
            "en": "One person",
            "ml": "ഒരാൾ"
          },
          "next": "invest.item.beneficiary.person"
        },
        {
          "id": "several",
          "label": {
            "en": "More than one person",
            "ml": "ഒന്നിലധികം പേർ"
          },
          "next": "invest.item.beneficiary.people"
        },
        {
          "id": "sell",
          "label": {
            "en": "Sell it, and add the money to my estate",
            "ml": "ഇത് വിറ്റ് പണം എന്റെ ആസ്തിയിലേക്ക് ചേർക്കുക"
          }
        },
        {
          "id": "residuary",
          "label": {
            "en": "Let it pass with the rest of my estate",
            "ml": "ബാക്കി സ്വത്തിനൊപ്പം പോകട്ടെ"
          }
        }
      ],
      "when": "{\"not\":{\"eq\":[\"invest.item.type\",\"insurance\"]}}",
      "next": "invest.item.nomination"
    },
    {
      "id": "invest.item.beneficiary.person",
      "section": "invest",
      "type": "person",
      "text": {
        "en": "Who?",
        "ml": "ആര്?"
      },
      "next": "invest.item.beneficiary.contingent.mode"
    },
    {
      "id": "invest.item.beneficiary.people",
      "section": "invest",
      "type": "personMulti",
      "text": {
        "en": "Who all?",
        "ml": "ആരെല്ലാം?"
      },
      "next": "invest.item.beneficiary.shares",
      "minPeople": 2
    },
    {
      "id": "invest.item.beneficiary.shares",
      "section": "invest",
      "type": "shares",
      "text": {
        "en": "How should it be divided?",
        "ml": "ഇത് എങ്ങനെ വീതിക്കണം?"
      },
      "next": "invest.item.beneficiary.contingent.group_mode",
      "peopleSource": "invest.item.beneficiary.people"
    },
    {
      "id": "invest.item.beneficiary.contingent.mode",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "If they don't survive you, this should go to:",
        "ml": "അവർ നിങ്ങൾക്ക് മുൻപ് മരിച്ചാൽ, ഇത് ആർക്ക് പോകണം:"
      },
      "options": [
        {
          "id": "children",
          "label": {
            "en": "Their children",
            "ml": "അവരുടെ മക്കൾക്ക്"
          }
        },
        {
          "id": "someone_else",
          "label": {
            "en": "Someone else",
            "ml": "മറ്റൊരാൾക്ക്"
          },
          "next": "invest.item.beneficiary.contingent.person"
        },
        {
          "id": "residuary",
          "label": {
            "en": "The rest of my estate",
            "ml": "ബാക്കി സ്വത്തിലേക്ക്"
          }
        }
      ],
      "next": "invest.item.nomination"
    },
    {
      "id": "invest.item.beneficiary.contingent.person",
      "section": "invest",
      "type": "person",
      "text": {
        "en": "Who?",
        "ml": "ആര്?"
      },
      "next": "invest.item.nomination"
    },
    {
      "id": "invest.item.beneficiary.contingent.group_mode",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "If any of them passes away before you, their share should:",
        "ml": "ഇവരിൽ ആരെങ്കിലും നിങ്ങൾക്ക് മുൻപ് മരിച്ചാൽ, അവരുടെ വിഹിതം:"
      },
      "options": [
        {
          "id": "children",
          "label": {
            "en": "Go to their children",
            "ml": "അവരുടെ മക്കൾക്ക് പോകട്ടെ"
          }
        },
        {
          "id": "others",
          "label": {
            "en": "Be shared by the others",
            "ml": "ബാക്കിയുള്ളവർക്കിടയിൽ വീതിക്കട്ടെ"
          }
        },
        {
          "id": "residuary",
          "label": {
            "en": "Go back to the rest of my estate",
            "ml": "ബാക്കി സ്വത്തിലേക്ക് തിരികെ പോകട്ടെ"
          }
        }
      ],
      "next": "invest.item.nomination"
    },
    {
      "id": "invest.item.nomination",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "Is the nomination on this up to date?",
        "ml": "ഇതിലെ നോമിനേഷൻ കാലികമാണോ?"
      },
      "help": {
        "en": "Retirement funds and insurance usually pay the nominee directly — this just helps your executor and heirs.",
        "ml": "റിട്ടയർമെന്റ് ഫണ്ടുകളും ഇൻഷുറൻസും സാധാരണയായി നോമിനിക്ക് നേരിട്ട് നൽകും — ഇത് നിങ്ങളുടെ എക്സിക്യൂട്ടർക്കും അവകാശികൾക്കും സഹായകമാകാൻ മാത്രം."
      },
      "options": [
        {
          "id": "same",
          "label": {
            "en": "Yes — the same person as above",
            "ml": "അതെ — മുകളിൽ പറഞ്ഞ അതേ ആൾ"
          }
        },
        {
          "id": "different",
          "label": {
            "en": "Yes — someone else",
            "ml": "അതെ — മറ്റൊരാൾ"
          }
        },
        {
          "id": "none",
          "label": {
            "en": "No / not sure",
            "ml": "ഇല്ല / ഉറപ്പില്ല"
          }
        }
      ],
      "nextRules": "[{\"when\":{\"eq\":[\"invest.item.type\",\"crypto\"]},\"goto\":\"invest.item.crypto_access\"}]",
      "next": "__ITEM_END__"
    },
    {
      "id": "invest.item.crypto_access",
      "section": "invest",
      "type": "single",
      "text": {
        "en": "Where will your executor find access instructions?",
        "ml": "നിങ്ങളുടെ എക്സിക്യൂട്ടർ ആക്സസ് നിർദ്ദേശങ്ങൾ എവിടെ കണ്ടെത്തും?"
      },
      "help": {
        "en": "Never typed here — a will can become a public document.",
        "ml": "ഇവിടെ ഒരിക്കലും ടൈപ്പ് ചെയ്യരുത് — വിൽപത്രം ഒരു പൊതു രേഖയായി മാറാം."
      },
      "options": [
        {
          "id": "sealed_envelope",
          "label": {
            "en": "A sealed envelope with my important papers",
            "ml": "എന്റെ പ്രധാന രേഖകൾക്കൊപ്പം അടച്ച കവറിൽ"
          }
        },
        {
          "id": "password_manager",
          "label": {
            "en": "My password manager's emergency access",
            "ml": "എന്റെ പാസ്‌വേഡ് മാനേജറിന്റെ എമർജൻസി ആക്സസിൽ"
          }
        },
        {
          "id": "trusted_person",
          "label": {
            "en": "A trusted person knows",
            "ml": "വിശ്വസ്തനായ ഒരാൾക്ക് അറിയാം"
          },
          "next": "invest.item.crypto_access.person"
        },
        {
          "id": "not_set",
          "label": {
            "en": "I'll set this up later",
            "ml": "ഞാൻ പിന്നീട് ക്രമീകരിക്കാം"
          }
        }
      ],
      "next": "__ITEM_END__"
    },
    {
      "id": "invest.item.crypto_access.person",
      "section": "invest",
      "type": "person",
      "text": {
        "en": "Who?",
        "ml": "ആര്?"
      },
      "next": "__ITEM_END__"
    }
  ]
}
