      },
      "gate": true,
      "options": [
        {
          "id": "burial",
          "label": {
            "en": "Burial",
            "ml": "ഖബറടക്കം"
          },
          "next": "funeral.burial.place"
        },
        {
          "id": "cremation",
          "label": {
            "en": "Cremation",
            "ml": "ദഹിപ്പിക്കൽ"
          },
          "next": "funeral.cremation.place"
        },
        {
          "id": "donate_science",
          "label": {
            "en": "Donate my body to medical science",
            "ml": "എന്റെ ശരീരം വൈദ്യശാസ്ത്ര പഠനത്തിന് ദാനം ചെയ്യുക"
          },
          "next": "funeral.body_donation.institution"
