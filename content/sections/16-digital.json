          "next": "digital.photos.recipient"
        },
        {
          "id": "review_first",
          "label": {
            "en": "A trusted person reviews first, deletes what's private",
            "ml": "വിശ്വസ്തനായ ഒരാൾ ആദ്യം പരിശോധിച്ച്, സ്വകാര്യമായത് ഡിലീറ്റ് ചെയ്യട്ടെ"
          },
          "next": "digital.photos.reviewer"
        },
        {
          "id": "delete_all",
          "label": {
            "en": "Delete them all",
            "ml": "എല്ലാം ഡിലീറ്റ് ചെയ്യുക"
