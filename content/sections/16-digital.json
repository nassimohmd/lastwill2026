      "next": "digital.access"
    },
    {
      "id": "digital.access",
      "section": "digital",
      "type": "single",
      "text": {
        "en": "Where will your digital executor find your access instructions?",
        "ml": "നിങ്ങളുടെ ഡിജിറ്റൽ എക്സിക്യൂട്ടർ ആക്സസ് നിർദ്ദേശങ്ങൾ എവിടെ കണ്ടെത്തും?"
      },
      "help": {
        "en": "Never typed here — a will can become a public document.",
        "ml": "ഇവിടെ ഒരിക്കലും ടൈപ്പ് ചെയ്യരുത് — വിൽപത്രം ഒരു പൊതു രേഖയായി മാറാം."
      },
      "options": [
        {
          "id": "sealed_envelope",
          "label": {
            "en": "A sealed envelope with my important papers",
            "ml": "എന്റെ പ്രധാന രേഖകൾക്കൊപ്പം അടച്ച കവറിൽ"
          }
        },
        {
          "id": "password_manager",
          "label": {
            "en": "My password manager's emergency access",
            "ml": "എന്റെ പാസ്‌വേഡ് മാനേജറിന്റെ എമർജൻസി ആക്സസിൽ"
          }
        },
        {
          "id": "trusted_person",
          "label": {
            "en": "A trusted person knows",
            "ml": "വിശ്വസ്തനായ ഒരാൾക്ക് അറിയാം"
          },
          "next": "digital.access.person"
        },
        {
          "id": "not_set",
          "label": {
            "en": "I'll set this up later",
            "ml": "ഞാൻ പിന്നീട് ക്രമീകരിക്കാം"
          }
        }
      ],
      "next": "residuary.primary"
    },
